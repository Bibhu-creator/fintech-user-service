meta {
  name: Upload KYC Document
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/kyc/upload?userId=4
  body: multipartForm
  auth: none
}

params:query {
  userId: 4
}

body:multipart-form {
  docType: AADHAAR
  docNumber: 1234-5678-9022
  file: @file(C:\fintech-uploads\test.pdf) @contentType(application/pdf)
}
